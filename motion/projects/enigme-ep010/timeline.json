onnee", "start": 34.42, "end": 35.035, "chunk": 2}, {"w": "au", "start": 35.035, "end": 35.265, "chunk": 2}, {"w": "mal", "start": 35.265, "end": 35.53, "chunk": 2}, {"w": "tout", "start": 35.63, "end": 35.93, "chunk": 3}, {"w": "en", "start": 35.93, "end": 36.16, "chunk": 3}, {"w": "valorisant", "start": 36.16, "end": 36.67, "chunk": 3}, {"w": "le", "start": 36.67, "end": 36.9, "chunk": 3}, {"w": "pardon", "start": 36.9, "end": 37.27, "chunk": 3}, {"w": "accompagne", "start": 37.37, "end": 37.88, "chunk": 4}, {"w": "d", "start": 37.88, "end": 38.075, "chunk": 4}, {"w": "une", "start": 38.075, "end": 38.34, "chunk": 4}, {"w": "demarche", "start": 38.34, "end": 38.78, "chunk": 4}, {"w": "de", "start": 38.78, "end": 39.01, "chunk": 4}, {"w": "reparation", "start": 39.01, "end": 39.52, "chunk": 4}], "chunks": [{"text": "Le Coran, en sourate 42, verset 40,", "start": 29.355, "end": 32.105}, {"text": "reconnaît la possibilité", "start": 32.205, "end": 33.455}, {"text": "d’une réponse proportionnée au mal,", "start": 33.555, "end": 35.53}, {"text": "tout en valorisant le pardon", "start": 35.63, "end": 37.27}, {"text": "accompagné d’une démarche de réparation.", "start": 37.37, "end": 39.52}]}, {"id": "s6a", "scene": 6, "start": 39.92, "end": 42.98, "display": "Le philosophe Jacques Derrida formule alors un paradoxe :", "words": [{"w": "le", "start": 39.92, "end": 40.15, "chunk": 0}, {"w": "philosophe", "start": 40.15, "end": 40.66, "chunk": 0}, {"w": "jacques", "start": 40.66, "end": 41.065, "chunk": 0}, {"w": "derrida", "start": 41.065, "end": 41.47, "chunk": 0}, {"w": "formule", "start": 41.57, "end": 41.975, "chunk": 1}, {"w": "alors", "start": 41.975, "end": 42.31, "chunk": 1}, {"w": "un", "start": 42.31, "end": 42.54, "chunk": 1}, {"w": "paradoxe", "start": 42.54, "end": 42.98, "chunk": 1}], "chunks": [{"text": "Le philosophe Jacques Derrida", "start": 39.92, "end": 41.47}, {"text": "formule alors un paradoxe :", "start": 41.57, "end": 42.98}]}, {"id": "s6b", "scene": 6, "start": 43.33, "end": 47.675, "display": "pardonner uniquement ce qui est pardonnable, est-ce encore véritablement pardonner ?", "words": [{"w": "pardonner", "start": 43.33, "end": 43.805, "chunk": 0}, {"w": "uniquement", "start": 43.805, "end": 44.315, "chunk": 0}, {"w": "ce", "start": 44.315, "end": 44.545, "chunk": 0}, {"w": "qui", "start": 44.545, "end": 44.81, "chunk": 0}, {"w": "est", "start": 44.81, "end": 45.075, "chunk": 0}, {"w": "pardonnable", "start": 45.075, "end": 45.62, "chunk": 0}, {"w": "est", "start": 45.72, "end": 45.985, "chunk": 1}, {"w": "ce", "start": 45.985, "end": 46.215, "chunk": 1}, {"w": "encore", "start": 46.215, "end": 46.585, "chunk": 1}, {"w": "veritablement", "start": 46.585, "end": 47.2, "chunk": 1}, {"w": "pardonner", "start": 47.2, "end": 47.675, "chunk": 1}], "chunks": [{"text": "pardonner uniquement ce qui est pardonnable,", "start": 43.33, "end": 45.62}, {"text": "est-ce encore véritablement pardonner ?", "start": 45.72, "end": 47.675}]}, {"id": "s7a", "scene": 7, "start": 48.575, "end": 53.66, "display": "Mais pardonner n’est pas excuser, oublier, rendre sa confiance ou renoncer à la justice.", "words": [{"w": "mais", "start": 48.575, "end": 48.875, "chunk": 0}, {"w": "pardonner", "start": 48.875, "end": 49.35, "chunk": 0}, {"w": "n", "start": 49.35, "end": 49.545, "chunk": 0}, {"w": "est", "start": 49.545, "end": 49.81, "chunk": 0}, {"w": "pas", "start": 49.81, "end": 50.075, "chunk": 0}, {"w": "excuser", "start": 50.075, "end": 50.48, "chunk": 0}, {"w": "oublier", "start": 50.58, "end": 50.985, "chunk": 1}, {"w": "rendre", "start": 50.985, "end": 51.355, "chunk": 1}, {"w": "sa", "start": 51.355, "end": 51.585, "chunk": 1}, {"w": "confiance", "start": 51.585, "end": 52.06, "chunk": 1}, {"w": "ou", "start": 52.16, "end": 52.39, "chunk": 2}, {"w": "renoncer", "start": 52.39, "end": 52.83, "chunk": 2}, {"w": "a", "start": 52.83, "end": 53.025, "chunk": 2}, {"w": "la", "start": 53.025, "end": 53.255, "chunk": 2}, {"w": "justice", "start": 53.255, "end": 53.66, "chunk": 2}], "chunks": [{"text": "Mais pardonner n’est pas excuser,", "start": 48.575, "end": 50.48}, {"text": "oublier, rendre sa confiance", "start": 50.58, "end": 52.06}, {"text": "ou renoncer à la justice.", "start": 52.16, "end": 53.66}]}, {"id": "s8a", "scene": 8, "start": 54.16, "end": 56.82, "display": "Alors, qui a le droit d’exiger ton pardon ?", "words": [{"w": "alors", "start": 54.16, "end": 54.495, "chunk": 0}, {"w": "qui", "start": 54.495, "end": 54.76, "chunk": 0}, {"w": "a", "start": 54.76, "end": 54.955, "chunk": 0}, {"w": "le", "start": 54.955, "end": 55.185, "chunk": 0}, {"w": "droit", "start": 55.185, "end": 55.52, "chunk": 0}, {"w": "d", "start": 55.62, "end": 55.815, "chunk": 1}, {"w": "exiger", "start": 55.815, "end": 56.185, "chunk": 1}, {"w": "ton", "start": 56.185, "end": 56.45, "chunk": 1}, {"w": "pardon", "start": 56.45, "end": 56.82, "chunk": 1}], "chunks": [{"text": "Alors, qui a le droit", "start": 54.16, "end": 55.52}, {"text": "d’exiger ton pardon ?", "start": 55.62, "end": 56.82}]}, {"id": "s9a", "scene": 9, "start": 57.37, "end": 61.37, "display": "Et si le pardon ne devenait une grandeur que lorsqu’il est libre…", "words": [{"w": "et", "start": 57.37, "end": 57.6, "chunk": 0}, {"w": "si", "start": 57.6, "end": 57.83, "chunk": 0}, {"w": "le", "start": 57.83, "end": 58.06, "chunk": 0}, {"w": "pardon", "start": 58.06, "end": 58.43, "chunk": 0}, {"w": "ne", "start": 58.43, "end": 58.66, "chunk": 0}, {"w": "devenait", "start": 58.66, "end": 59.1, "chunk": 0}, {"w": "une", "start": 59.1, "end": 59.365, "chunk": 0}, {"w": "grandeur", "start": 59.365, "end": 59.805, "chunk": 0}, {"w": "que", "start": 59.905, "end": 60.17, "chunk": 1}, {"w": "lorsqu", "start": 60.17, "end": 60.54, "chunk": 1}, {"w": "il", "start": 60.54, "end": 60.77, "chunk": 1}, {"w": "est", "start": 60.77, "end": 61.035, "chunk": 1}, {"w": "libre", "start": 61.035, "end": 61.37, "chunk": 1}], "chunks": [{"text": "Et si le pardon ne devenait une grandeur", "start": 57.37, "end": 59.805}, {"text": "que lorsqu’il est libre…", "start": 59.905, "end": 61.37}]}, {"id": "s9b", "scene": 9, "start": 61.67, "end": 62.64, "display": "et jamais imposé ?", "words": [{"w": "et", "start": 61.67, "end": 61.9, "chunk": 0}, {"w": "jamais", "start": 61.9, "end": 62.27, "chunk": 0}, {"w": "impose", "start": 62.27, "end": 62.64, "chunk": 0}], "chunks": [{"text": "et jamais imposé ?", "start": 61.67, "end": 62.64}]}]}