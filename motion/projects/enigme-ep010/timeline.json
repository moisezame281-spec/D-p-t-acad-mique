": "l", "start": 8.905, "end": 9.1, "chunk": 2}, {"w": "a", "start": 9.1, "end": 9.295, "chunk": 2}, {"w": "commis", "start": 9.295, "end": 9.665, "chunk": 2}, {"w": "n", "start": 9.765, "end": 9.96, "chunk": 3}, {"w": "a", "start": 9.96, "end": 10.155, "chunk": 3}, {"w": "peut", "start": 10.155, "end": 10.455, "chunk": 3}, {"w": "etre", "start": 10.455, "end": 10.755, "chunk": 3}, {"w": "meme", "start": 10.755, "end": 11.055, "chunk": 3}, {"w": "pas", "start": 11.055, "end": 11.32, "chunk": 3}, {"w": "reconnu", "start": 11.32, "end": 11.725, "chunk": 3}, {"w": "sa", "start": 11.725, "end": 11.955, "chunk": 3}, {"w": "faute", "start": 11.955, "end": 12.29, "chunk": 3}], "chunks": [{"text": "Mais pourquoi demander à celui qui a subi le mal", "start": 3.375, "end": 6.34}, {"text": "de fermer le livre,", "start": 6.44, "end": 7.605}, {"text": "alors que celui qui l’a commis", "start": 7.705, "end": 9.665}, {"text": "n’a peut-être même pas reconnu sa faute ?", "start": 9.765, "end": 12.29}]}, {"id": "s3a", "scene": 3, "start": 12.79, "end": 16.24, "display": "Imagine une personne qui te blesse, s’excuse, puis recommence.", "words": [{"w": "imagine", "start": 12.79, "end": 13.195, "chunk": 0}, {"w": "une", "start": 13.195, "end": 13.46, "chunk": 0}, {"w": "personne", "start": 13.46, "end": 13.9, "chunk": 0}, {"w": "qui", "start": 13.9, "end": 14.165, "chunk": 0}, {"w": "te", "start": 14.165, "end": 14.395, "chunk": 0}, {"w": "blesse", "start": 14.395, "end": 14.765, "chunk": 0}, {"w": "s", "start": 14.865, "end": 15.06, "chunk": 1}, {"w": "excuse", "start": 15.06, "end": 15.43, "chunk": 1}, {"w": "puis", "start": 15.43, "end": 15.73, "chunk": 1}, {"w": "recommence", "start": 15.73, "end": 16.24, "chunk": 1}], "chunks": [{"text": "Imagine une personne qui te blesse,", "start": 12.79, "end": 14.765}, {"text": "s’excuse, puis recommence.", "start": 14.865, "end": 16.24}]}, {"id": "s3b", "scene": 3, "start": 16.64, "end": 21.87, "display": "À quel moment le pardon cesse-t-il d’être une liberté et devient-il une permission ?", "words": [{"w": "a", "start": 16.64, "end": 16.835, "chunk": 0}, {"w": "quel", "start": 16.835, "end": 17.135, "chunk": 0}, {"w": "moment", "start": 17.135, "end": 17.505, "chunk": 0}, {"w": "le", "start": 17.505, "end": 17.735, "chunk": 0}, {"w": "pardon", "start": 17.735, "end": 18.105, "chunk": 0}, {"w": "cesse", "start": 18.105, "end": 18.44, "chunk": 0}, {"w": "t", "start": 18.44, "end": 18.635, "chunk": 0}, {"w": "il", "start": 18.635, "end": 18.865, "chunk": 0}, {"w": "d", "start": 18.965, "end": 19.16, "chunk": 1}, {"w": "etre", "start": 19.16, "end": 19.46, "chunk": 1}, {"w": "une", "start": 19.46, "end": 19.725, "chunk": 1}, {"w": "liberte", "start": 19.725, "end": 20.13, "chunk": 1}, {"w": "et", "start": 20.23, "end": 20.46, "chunk": 2}, {"w": "devient", "start": 20.46, "end": 20.865, "chunk": 2}, {"w": "il", "start": 20.865, "end": 21.095, "chunk": 2}, {"w": "une", "start": 21.095, "end": 21.36, "chunk": 2}, {"w": "permission", "start": 21.36, "end": 21.87, "chunk": 2}], "chunks": [{"text": "À quel moment le pardon cesse-t-il", "start": 16.64, "end": 18.865}, {"text": "d’être une liberté", "start": 18.965, "end": 20.13}, {"text": "et devient-il une permission ?", "start": 20.23, "end": 21.87}]}, {"id": "s4a", "scene": 4, "start": 22.37, "end": 28.955, "display": "Dans l’Évangile selon Luc, au chapitre 17, Jésus associe la confrontation du tort, le repentir et le pardon.", "words": [{"w": "dans", "start": 22.37, "end": 22.67, "chunk": 0}, {"w": "l", "start": 22.67, "end": 22.865, "chunk": 0}, {"w": "evangile", "start": 22.865, "end": 23.305, "chunk": 0}, {"w": "selon", "start": 23.305, "end": 23.64, "chunk": 0}, {"w": "luc", "start": 23.64, "end": 23.905, "chunk": 0}, {"w": "au", "start": 23.905, "end": 24.135, "chunk": 0}, {"w": "chapitre", "start": 24.135, "end": 24.575, "chunk": 0}, {"w": "dix", "start": 24.575, "end": 24.84, "chunk": 0}, {"w": "sept", "start": 24.84, "end": 25.14, "chunk": 0}, {"w":